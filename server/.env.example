# Server environment — copy to .env and fill in real values. Never commit .env.
PORT=4000
NODE_ENV=development

# MongoDB
MONGO_URI=mongodb://127.0.0.1:27017/whatsapp_clone

# Auth — generate a long random string (e.g. `openssl rand -base64 48`)
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# Google OAuth (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Frontend origin (for CORS + cookies)
CLIENT_URL=http://localhost:5173

# Cloudinary (https://console.cloudinary.com/settings/api-keys)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
